# Gateway
PORT=8080
NODE_ID=gw-1
# REQUIRED — generate with: openssl rand -hex 32
JWT_SECRET=
# REQUIRED — pick a strong password for the admin login
AUTH_PASSWORD=
DEV_TOKENS=true                    # exposes POST /dev/token for the demo UI. NEVER enable in production.

# Backplane: redis | memory (memory = single node, no Redis needed)
BACKPLANE=redis
# Local docker:        redis://redis:6379
# ElastiCache (TLS):   rediss://master.xxxxx.cache.amazonaws.com:6379   (+ auth token: rediss://:TOKEN@host:6379)
# Redis Cloud free:    rediss://default:PASSWORD@redis-1234.c1.region.cloud.redislabs.com:12345
# Upstash free:        rediss://default:PASSWORD@xxxx.upstash.io:6379
REDIS_URL=redis://127.0.0.1:6379

# Tuning (defaults shown)
# MAX_TEXT=2000  RATE_BURST=40  RATE_REFILL=20  MAX_CONNS_PER_TENANT=5000
# STREAM_MAXLEN=2000  HISTORY_ON_JOIN=50  DEDUPE_TTL_SEC=300
# PRESENCE_TTL_MS=30000  PRESENCE_REFRESH_MS=10000  HEARTBEAT_MS=15000  MAX_BUFFER_BYTES=1048576

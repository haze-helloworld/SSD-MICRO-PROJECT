# Production Environment Configuration
NODE_ENV=production
PORT=8080
NODE_ID=gw-prod-1

# Security
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET=replace-with-a-strong-random-production-secret
# Set to 'false' in true production; 'true' enables demo UI quick login & token generation
DEV_TOKENS=true

# Backplane Configuration
BACKPLANE=redis

# Hosted Redis Connection Strings:
# Upstash Redis:       rediss://default:PASSWORD@endpoint.upstash.io:6379
# Redis Cloud (Aiven): rediss://default:PASSWORD@endpoint.cloud.redislabs.com:12345
# AWS ElastiCache:     rediss://master.xxxxxx.cache.amazonaws.com:6379
# Docker Compose:      redis://redis:6379
REDIS_URL=redis://127.0.0.1:6379

# AWS CloudWatch Metrics Integration (AWS Learner Lab / Production)
# AWS credentials are entered via the UI CloudWatch pill after deploy.
# Do NOT put AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, or AWS_SESSION_TOKEN here.
AWS_REGION=us-east-1

# Production Limits & Tuning
STREAM_MAXLEN=5000
HISTORY_ON_JOIN=50
DEDUPE_TTL_SEC=300
MAX_CONNS_PER_TENANT=5000
RATE_BURST=50
RATE_REFILL=25
MAX_TEXT=4000
HEARTBEAT_MS=15000

